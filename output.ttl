<http://data.europa.eu/it6/classification> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "classification"@en ;
    rdfs:comment "The classification of the modality."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/download> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "download"@en ;
    rdfs:comment "The number of downloads of the machine learning model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/featureIndex> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "feature index"@en ;
    rdfs:comment "The feature on which the quality is measure on."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/fineTunedFrom> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "fine tuned from"@en ;
    rdfs:comment "The model from on which this model has been fine tuned."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasBenchmark> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has benchmark"@en ;
    rdfs:comment "The benchmarks used to evaluate this model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasBibliographicReference> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has bibliographic reference"@en ;
    rdfs:comment "The reference to a paper."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasCostMatrix> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has cost matrix"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasDependency> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has dependency"@en ;
    rdfs:comment "The libraries that a flow depends on."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasDocument> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has document"@en ;
    rdfs:comment "The url or location of the document itself."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasEngagement> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has engagement"@en ;
    rdfs:comment "Statistics resulting of user engagement."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasEstimationProcedure> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has estimation procedure"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasEvaluation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has evaluation"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasEvaluationMeasure> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has evaluation measure"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasFeature> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has feature"@en ;
    rdfs:comment "The attribute or column being part of a distribution."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasFile> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has file"@en ;
    rdfs:comment "The file in which the model is expressed."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasFlow> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has flow"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasFlowParameter> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has flow parameter"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasHardware> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has hardware"@en ;
    rdfs:comment "The hardware associated with the computer infrastructure."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasInferencingImpact> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has inferencing impact"@en ;
    rdfs:comment "The impact of inferencing the model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasInputModality> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has input modality"@en ;
    rdfs:comment "The modality of the input of the model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasLibrary> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has library"@en ;
    rdfs:comment "The library associated with the computer infrastructure."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasOutput> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasOutputFileDescription> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has output file description"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasOutputFilePrediction> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has output file prediction"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasOutputModality> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has output modality"@en ;
    rdfs:comment "The modality of the output of the model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasParameter> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has parameter"@en ;
    rdfs:comment "The configured setting."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasPrediction> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has prediction"@en ;
    rdfs:comment "The predicted dataset generated as output of a machine learning model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasPredictionFeature> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has prediction feature"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasProvider> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has provider"@en ;
    rdfs:comment "A natural or legal person, public authority, agency or other body that develops a Machine Learning Model or places it on the market or puts the it into service under its own name or trademark, whether for payment or free of charge."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasRegisteredUser> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has registered user"@en ;
    rdfs:comment "The registered user associated to the model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasRepository> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has repository"@en ;
    rdfs:comment "The repository associated."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasRisk> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has risk"@en ;
    rdfs:comment "A possible risk that can occur."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasRun> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has run"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasSplit> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has split"@en ;
    rdfs:comment "The split that is used for the estimation procedure."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasTask> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has task"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasTaskType> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has task type"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasTrainingImpact> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has training impact"@en ;
    rdfs:comment "Measured or estimated amount of energy used for training."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasUploader> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has uploader"@en ;
    rdfs:comment "An entity responsible for uploading the resource."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/hasVariation> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has variation"@en ;
    rdfs:comment "The model that is variant of this model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/isAppliedTo> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is applied to"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/isExecutedBy> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "is executed by"@en ;
    rdfs:comment "The library that is executed by this file."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/like> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "like"@en ;
    rdfs:comment "The number of likes the machine learning model received."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/nature> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "nature"@en ;
    rdfs:comment "The inherent characteristics of the risk."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/numberOfDatapoints> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "number of datapoints"@en ;
    rdfs:comment "The total count of individual data entries or observations contained."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/runnedOn> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "runned on"@en ;
    rdfs:comment "The dataset on which a machine learning model is executed."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/servesModel> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "serves model"@en ;
    rdfs:comment "A model that this data service can distribute."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/source> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "source"@en ;
    rdfs:comment "The origin or cause of the risk."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/sourceData> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "source data"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/targetFeature> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "target feature"@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/testedOn> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "tested on"@en ;
    rdfs:comment "The testing dataset used to evaluate the machine learning model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/totalNumberOfParameters> a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "total number of parameters"@en ;
    rdfs:comment "The total number of parameters of the model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/trainedOn> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "trained on"@en ;
    rdfs:comment "The training dataset used to train the machine learning model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/url> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "url"@en ;
    rdfs:comment "The url of the file to be downloaded."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/validatedOn> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "validated on"@en ;
    rdfs:comment "The validation dataset used to fine-tune the machine learning model."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

<http://data.europa.eu/it6/visibility> a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "visibility"@en ;
    rdfs:comment "Settings for a dataset that determine who can access or view it. Options typically include 'Everyone', 'All my friends', 'Only me', or specific user-defined circles."@en ;
    rdfs:isDefinedBy <http://data.europa.eu/it6/> .

